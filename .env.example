# ----- Database -----
# MongoDB Atlas connection string (M0 free tier). Allow 0.0.0.0/0 for Vercel.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/school?retryWrites=true&w=majority"

# ----- Auth (NextAuth) -----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ----- Admin seed (used by `npm run seed:admin`) -----
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL="admin@school.example"
SEED_ADMIN_PASSWORD="change-me"

# ----- Cloudinary (image/PDF uploads) -----
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ----- Email (Resend) -----
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
# Where contact-form enquiries are emailed.
CONTACT_INBOX_EMAIL="rrissamastipur@gmail.com"

# ----- Site -----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ----- Analytics (optional) -----
# Set to a GA4 Measurement ID (e.g. G-XXXXXXX) to enable Google Analytics.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
